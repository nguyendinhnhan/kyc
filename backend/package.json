{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js + Fastify backend for KYC onboarding.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_NO_WARNINGS=1 vitest",
    "test:coverage": "NODE_NO_WARNINGS=1 vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/env": "^7.0.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.4",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
