# Development Environment Configuration
# This file is for development environment only

# API Configuration
# Use 10.0.2.2 for Android emulator, localhost for iOS simulator
# Use your computer's IP for physical devices (e.g., 192.168.1.100)
API_BASE_URL=http://192.168.1.66:3000
API_CONNECT_TIMEOUT=30000
API_RECEIVE_TIMEOUT=60000

# App Configuration
APP_NAME=KYC Onboarding Dev
APP_ENV=development

# Feature Flags
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
